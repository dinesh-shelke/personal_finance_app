{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // `jest` supplies describe/it/expect to the test files; without it
    // `npm run typecheck` fails on every assertion.
    "types": ["jest"],
    "paths": {
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
