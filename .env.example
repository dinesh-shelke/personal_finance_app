# Copy to `.env` and fill in. `.env` is gitignored — never commit real values.
#
# Everything below comes from one place in the Supabase dashboard:
#   https://supabase.com/dashboard  ->  your project  ->  Settings (gear, bottom
#   of the left sidebar)  ->  "API Keys"  (project URL is on the "API" page)
#
# Shortcut: the green "Connect" button in the top bar shows the URL and the
# publishable key together, already formatted for copying.

# ---------------------------------------------------------------------------
# Shipped inside the Android APK. Both are PUBLIC by design — Row Level
# Security is what protects the data, not the secrecy of these values.
# ---------------------------------------------------------------------------

# Settings -> API -> "Project URL". Always https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"

# Settings -> API Keys -> "Publishable key" tab.
# If the project predates the new key format, use Settings -> API Keys ->
# "Legacy API Keys" tab -> `anon` key instead. Both work; the anon key is a
# long JWT starting `eyJ...` rather than `sb_publishable_...`.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# ---------------------------------------------------------------------------
# Local tooling only. NOT bundled into the app (no EXPO_PUBLIC_ prefix).
# ---------------------------------------------------------------------------

# The subdomain of your project URL above, e.g. abcdefghijklmnopqrst.
# Also shown at Settings -> General -> "Project ID". Used by `npm run types:db`.
SUPABASE_PROJECT_ID=""

# ---------------------------------------------------------------------------
# !! SECRET !! This key BYPASSES Row Level Security completely. Anyone holding
# it can read and modify every family member's data. Keep it in this file only,
# never paste it into a chat, an issue, or a screenshot, and never add it to
# EAS or to the app bundle.
#
# Settings -> API Keys -> "Secret keys" tab -> reveal and copy (`sb_secret_...`).
# On older projects: "Legacy API Keys" tab -> `service_role` key (a JWT).
#
# Used ONLY by `npm run test:rls`, to create and delete the two throwaway test
# users. Nothing in src/ references it. If it ever leaks, rotate it on that same
# page immediately.
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=""
