# Copy to `.env` and fill in. `.env` is gitignored — never commit real values.
#
# Both of these are intentionally public: they ship inside the Android APK.
# Row Level Security is what protects the data, not the secrecy of these keys.
# Supabase dashboard -> Project Settings -> API
EXPO_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# ---------------------------------------------------------------------------
# Local tooling only. NOT bundled into the app (no EXPO_PUBLIC_ prefix).
# ---------------------------------------------------------------------------

# Supabase project ref, e.g. abcdefghijklmnop. Used by `npm run types:db`.
SUPABASE_PROJECT_ID=""

# Service-role key. Used ONLY by `npm run test:rls` to create/tear down the two
# throwaway test users. Never reference this from app code.
SUPABASE_SERVICE_ROLE_KEY=""
